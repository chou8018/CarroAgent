{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "jsxImportSource": "react",
    "types": ["react-native", "node"],
    "typeRoots": ["node_modules/@types", "src/api/services"],
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
